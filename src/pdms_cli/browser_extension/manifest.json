{
  "manifest_version": 3,
  "name": "pdms front redirect",
  "version": "1.1.0",
  "description": "Opens the PDMS web app that pdms runs on this computer when you go to the known front (pdms ui, Settings → Browser).",
  "key": "",
  "icons": {"128": "icon.png"},
  "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "storage"],
  "host_permissions": ["https://*.alivi.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_icon": {"128": "icon.png"}, "default_title": "pdms front redirect", "default_popup": "popup.html"}
}
